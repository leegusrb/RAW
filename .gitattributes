# Default text behavior
* text=auto

# Code and text files
*.cs text eol=lf
*.shader text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.md text eol=lf

# Unity serialized files
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
